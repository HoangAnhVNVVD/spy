# Server Configuration (Railway or Local)
PORT=8000
HOST=0.0.0.0
# Railway Postgres connection string (if Railway Postgres plugin attached)
# Example: postgresql://postgres:password@roundhouse.proxy.rlwy.net:12345/railway
# If empty, automatically uses SQLite in ./data/tracker.db
DATABASE_URL=

# Secret token used by Windows clients to push activity batches
API_KEY=your-secure-random-token-here

# Set to true if you want to require Bearer token to read analytics/dashboard
REQUIRE_AUTH_FOR_READS=false

# Client Configuration (for Windows client)
ACTIVITY_SERVER_URL=http://localhost:8000
ACTIVITY_API_TOKEN=your-secure-random-token-here
ACTIVITY_CLIENT_ID=my-windows-pc
ACTIVITY_IDLE_THRESHOLD=120
ACTIVITY_SYNC_INTERVAL=30
ACTIVITY_POLL_INTERVAL=1.0
